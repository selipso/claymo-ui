---
import { theme } from "@claymo/core/reference";
import Showcase from "../layouts/Showcase.astro";
import Gallery from "../demo/Gallery.svelte";
import "../demo/gallery.css";

const motionPresets = Object.entries(theme.motion.presets).map(([value, preset]) => ({
  value,
  ...preset,
}));
---

<Showcase title="Gallery" route="gallery" framework="svelte">
  <Gallery client:load {motionPresets} />
</Showcase>
