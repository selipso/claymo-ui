---
import { TextField } from "@claymo/astro";
import { modes, theme } from "@claymo/core/reference";

const palettes = Object.entries(theme.palettes).map(([value, { label }]) => ({ value, label }));
const modeOptions = modes.map((value) => ({
  value,
  label: value[0].toUpperCase() + value.slice(1),
}));
---

<div class="theme-controls">
  <TextField select size="small" id="site-palette" label="Palette" options={palettes} />
  <TextField select size="small" id="site-mode" label="Mode" options={modeOptions} />
</div>

<script>
  import { THEME_CHANGE_EVENT, readTheme, setTheme, type Mode } from "../lib/theme";

  function sync() {
    const { palette, mode } = readTheme();
    const paletteSelect = document.querySelector<HTMLSelectElement>("#site-palette");
    const modeSelect = document.querySelector<HTMLSelectElement>("#site-mode");
    if (paletteSelect) paletteSelect.value = palette;
    if (modeSelect) modeSelect.value = mode;
  }

  document.addEventListener("astro:page-load", sync);
  window.addEventListener(THEME_CHANGE_EVENT, sync);
  document.addEventListener("change", ({ target }) => {
    if (!(target instanceof HTMLSelectElement)) return;
    if (target.id === "site-palette") setTheme({ palette: target.value });
    if (target.id === "site-mode") setTheme({ mode: target.value as Mode });
  });
</script>

<style>
  .theme-controls {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 10px;
  }
</style>
