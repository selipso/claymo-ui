---
import { Code } from "astro:components";
import type { ComponentReference } from "@claymo/core/reference";
import { Table } from "@claymo/astro";
import { exampleSlug } from "../lib/nav";
import { propDefault, propType } from "../lib/prop-schema";

interface Props {
  reference: ComponentReference;
}
const { reference } = Astro.props;
const { framework, name, props, content, events, examples } = reference;
const required = new Set(props.required);
const rows = Object.entries(props.properties).map(([prop, schema]) => ({
  prop: required.has(prop) ? `${prop} (required)` : prop,
  type: propType(schema),
  defaultValue: propDefault(schema),
  description: typeof schema.description === "string" ? schema.description : "",
}));
---

<section class="reference-panel">
  <h2>Examples</h2>
  {examples.map(({ title, source }, index) => (
    <section class="reference-panel__example" aria-labelledby={`${framework}-example-${index}`}>
      <h3 id={`${framework}-example-${index}`}>{title}</h3>
      <iframe
        class="reference-panel__frame"
        src={`/examples/${framework}/${exampleSlug(name, index)}/`}
        title={`${title}, ${framework} example`}
        loading="lazy"
        data-example
      ></iframe>
      <Code code={source} lang={framework === "solid" ? "tsx" : framework} wrap />
    </section>
  ))}

  <h2>Props</h2>
  {rows.length === 0 ? (
    <p>No component-specific props; native attributes pass through.</p>
  ) : (
    <Table label={`${name} props, ${framework}`} size="small">
      <thead>
        <tr>
          <th scope="col">Prop</th>
          <th scope="col">Type</th>
          <th scope="col">Default</th>
          <th scope="col">Description</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row">
              <code>{row.prop}</code>
            </th>
            <td>
              <code>{row.type}</code>
            </td>
            <td>{row.defaultValue && <code>{row.defaultValue}</code>}</td>
            <td>{row.description}</td>
          </tr>
        ))}
      </tbody>
    </Table>
  )}

  {content.length > 0 && (
    <>
      <h2>Content</h2>
      <ul>
        {content.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </>
  )}

  {events.length > 0 && (
    <>
      <h2>Events</h2>
      <ul>
        {events.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </>
  )}
</section>

<style>
  .reference-panel__frame {
    display: block;
    width: 100%;
    min-height: 120px;
    border: var(--clay-border-width, 1px) solid var(--clay-edge);
    border-radius: 24px;
    background: var(--clay-page);
  }

  .reference-panel h2 {
    font-size: 1.25rem;
  }

  .reference-panel h3 {
    margin-block: 28px 12px;
    font-size: 1.05rem;
  }

  .reference-panel__example :global(pre) {
    margin-block-start: 12px;
  }
</style>
