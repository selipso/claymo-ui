---
import "../lib/styles/clay.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
    <script is:inline>
      try {
        var t = localStorage.getItem("clay-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <!-- Must not be display:none: that disables the filter and clipPath. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter
        id="clay-lit"
        x="-5%"
        y="-5%"
        width="110%"
        height="110%"
        color-interpolation-filters="sRGB"
      >
        <feGaussianBlur in="SourceAlpha" stdDeviation="7" result="height"></feGaussianBlur>
        <feDiffuseLighting
          in="height"
          surfaceScale="6"
          diffuseConstant="1"
          lighting-color="#fff"
          result="diffuse"
        >
          <feDistantLight azimuth="225" elevation="55"></feDistantLight>
        </feDiffuseLighting>
        <feSpecularLighting
          in="height"
          surfaceScale="7"
          specularConstant="0.6"
          specularExponent="22"
          lighting-color="#fff"
          result="spec"
        >
          <feDistantLight azimuth="225" elevation="55"></feDistantLight>
        </feSpecularLighting>
        <feComposite
          in="diffuse"
          in2="SourceGraphic"
          operator="arithmetic"
          k1="1.2"
          k2="0"
          k3="0"
          k4="0"
          result="shaded"
        ></feComposite>
        <feComposite
          in="shaded"
          in2="spec"
          operator="arithmetic"
          k1="0"
          k2="1"
          k3="0.3"
          k4="0"
          result="lit"
        ></feComposite>
        <feComposite in="lit" in2="SourceAlpha" operator="in"></feComposite>
      </filter>
      <clipPath id="clay-bulge" clipPathUnits="objectBoundingBox">
        <path d="M0.5,0.02 C0.80,0.02 0.98,0.20 0.98,0.5 C0.98,0.80 0.80,0.98 0.5,0.98 C0.20,0.98 0.02,0.80 0.02,0.5 C0.02,0.20 0.20,0.02 0.5,0.02 Z"></path>
      </clipPath>
    </svg>
    <slot />
  </body>
</html>
