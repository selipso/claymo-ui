---
import Base from "../layouts/Base.astro";

const variants = [
  {
    id: "a",
    title: "A. Article recipe only",
    caption:
      "One large offset drop shadow + a light top-left and dark bottom-right inset shadow, on a plain rounded rectangle. Pure box-shadow + border-radius: works in every browser.",
  },
  {
    id: "b",
    title: "B. A + squircle corners",
    caption:
      "Adds corner-shape: squircle (Chromium 139+). Corners become smoother and puffier; shadows follow the shape. Browsers without it fall back to A, so it is safe to ship as an enhancement.",
  },
  {
    id: "c",
    title: "C. B + inflated lighting filter",
    caption:
      "Replaces the inset shadows with an SVG feDiffuse/feSpecularLighting pass over a blurred alpha height-map: a real dome highlight that follows any silhouette. Works in all engines; repaints on resize, so use it on small static elements.",
  },
  {
    id: "d",
    title: "D. Bulged silhouette",
    caption:
      "The article's 'drag the side midpoints outwards' shape: clip-path with an objectBoundingBox Bezier path. Truly convex on every edge, but proportions are fixed and box-shadow is clipped, so the drop shadow comes from a parent filter: drop-shadow().",
  },
];
---

<Base title="clay-ui lab: can CSS do claymorphism?">
  <main class="lab">
    <p><a href="/">&larr; Back to app demo</a> &middot; <a href="/components/">Component gallery</a></p>
    <h1>Can CSS do claymorphism?</h1>
    <p class="lead">
      The article says the effect is &ldquo;not really possible to achieve in CSS just yet&rdquo;. The shadow recipe is
      plain CSS; the bulged silhouette needs one of three emulations. All four stages below use the same palette so
      you can judge each technique by eye. Toggle your OS light/dark preference to check both themes.
    </p>

    <div class="grid">
      {
        variants.map((v) => (
          <section class={`panel variant-${v.id}`} aria-labelledby={`h-${v.id}`}>
            <h2 id={`h-${v.id}`}>{v.title}</h2>
            <div class="stage">
              {v.id === "d" ? (
                <>
                  <div class="drop">
                    <div class="clay shape btn-shape" data-inflated>Button size</div>
                  </div>
                  <div class="drop">
                    <div class="clay shape card-shape" data-inflated>Card size</div>
                  </div>
                </>
              ) : (
                <>
                  <div class="clay shape btn-shape" data-inflated={v.id === "c" ? "" : undefined}>Button size</div>
                  <div class="clay shape card-shape" data-inflated={v.id === "c" ? "" : undefined}>Card size</div>
                </>
              )}
            </div>
            <p class="caption">{v.caption}</p>
          </section>
        ))
      }
    </div>

    <section class="clay support" aria-labelledby="support-h">
      <h2 id="support-h">Support in this browser</h2>
      <table>
        <caption class="clay-sr-only">Feature support detected with CSS.supports</caption>
        <thead>
          <tr><th scope="col">Feature</th><th scope="col">Used for</th><th scope="col">Supported</th></tr>
        </thead>
        <tbody id="support-rows"></tbody>
      </table>
    </section>
  </main>

  <script is:inline>
    var checks = [
      ["corner-shape: squircle", "Puffy corners (B)", ["corner-shape", "squircle"]],
      ["color-mix(in oklab, ...)", "Derived highlight / shade colours", ["color", "color-mix(in oklab, red, blue)"]],
      ["light-dark()", "Single-block light and dark theme", ["color", "light-dark(red, blue)"]],
    ];
    var body = document.getElementById("support-rows");
    checks.forEach(function (c) {
      var ok = CSS.supports(c[2][0], c[2][1]);
      var tr = document.createElement("tr");
      [c[0], c[1], ok ? "Yes" : "No (falls back)"].forEach(function (text, i) {
        var td = document.createElement(i === 0 ? "th" : "td");
        if (i === 0) td.scope = "row";
        td.textContent = text;
        tr.appendChild(td);
      });
      tr.dataset.supported = String(ok);
      body.appendChild(tr);
    });
  </script>
</Base>

<style>
  .lab {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 20px 64px;
  }
  a { color: var(--clay-primary-ink); }
  h1 { font-size: 2.25rem; line-height: 1.2; margin: 8px 0 12px; }
  h2 { font-size: 1.25rem; margin: 0 0 16px; }
  .lead { max-width: 70ch; color: var(--clay-ink-muted); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 28px;
    margin: 32px 0;
  }
  .panel {
    padding: 28px;
    border-radius: 28px;
    background: var(--clay-surface);
    border: 2px solid var(--clay-edge);
  }
  .stage {
    display: flex;
    flex-wrap: wrap;
    gap: 36px;
    align-items: center;
    padding: 28px 12px;
    border-radius: 20px;
    background: var(--clay-page);
  }
  .shape {
    --clay-d: 8px;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    font-weight: 600;
  }
  .btn-shape {
    --clay-color: var(--clay-primary);
    --clay-radius: 22px;
    width: 160px;
    height: 56px;
    color: var(--clay-primary-on);
  }
  .card-shape {
    --clay-color: var(--clay-surface);
    --clay-radius: 32px;
    --clay-d: 12px;
    width: 200px;
    height: 130px;
    color: var(--clay-ink);
  }
  .variant-a .clay { corner-shape: round; }
  .drop { filter: drop-shadow(10px 14px 14px var(--drop-color)); }
  .variant-d { --drop-color: color-mix(in oklab, #000, transparent 55%); }
  .variant-d .shape {
    box-shadow: none;
    clip-path: url(#clay-bulge);
    border-radius: 0;
  }
  .variant-d .btn-shape { width: 190px; height: 84px; }
  .variant-d .card-shape { width: 190px; height: 150px; }
  .caption { margin: 16px 0 0; color: var(--clay-ink-muted); font-size: 0.9375rem; }
  .support { padding: 28px; margin-top: 8px; }
  .support :global(table) { width: 100%; border-collapse: collapse; }
  .support :global(th), .support :global(td) { text-align: left; padding: 10px 12px; border-bottom: 2px solid var(--clay-edge); }
  .support :global(tr:last-child th), .support :global(tr:last-child td) { border-bottom: 0; }
</style>
