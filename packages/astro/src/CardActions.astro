---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & { disableSpacing?: boolean };

const { disableSpacing = false, class: className, ...rest } = Astro.props;
---

<div
  class:list={["clay-card-actions", className]}
  data-no-spacing={disableSpacing ? "" : undefined}
  {...rest}
>
  <slot />
</div>
