---
import type { HTMLAttributes } from "astro/types";
import { typographyTag, type TypographyOptions } from "@claymo/core/surfaces";

type Props = Omit<HTMLAttributes<"p">, "color"> & TypographyOptions;

const {
  variant = "body1",
  as,
  variantMapping,
  color = "inherit",
  gutterBottom = false,
  noWrap = false,
  align = "inherit",
  class: className,
  ...rest
} = Astro.props;
const Tag = typographyTag(variant, as, variantMapping);
---

<Tag
  class:list={["clay-typography", className]}
  data-variant={variant}
  data-gutter-bottom={gutterBottom ? "" : undefined}
  data-no-wrap={noWrap ? "" : undefined}
  data-tcolor={color}
  data-align={align}
  {...rest}
>
  <slot />
</Tag>
