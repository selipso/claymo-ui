---
import type { HTMLAttributes } from "astro/types";
import type { MotionPreset } from "@claymo/core";
import type { DrawerOptions } from "@claymo/core/overlays";

/**
 * A temporary drawer is a native modal dialog: target its id with `commandfor` and
 * `command="show-modal"` / `command="close"`, or call `showModal()` / `close()`.
 * Escape and backdrop clicks fire cancelable `clay-request-close` with `detail.reason`.
 * Toggle a persistent drawer's native `hidden` property after rendering.
 * Slots: default (content), `actions`.
 */
type Props = Omit<HTMLAttributes<"dialog">, keyof DrawerOptions> &
  DrawerOptions & {
    "aria-label": string;
    /** Motion preset for this component and its contents; omitted, it inherits the surrounding preset (default subtle). */
    motion?: MotionPreset;
  };

const {
  variant = "temporary",
  anchor = "left",
  width = 280,
  open = false,
  hideBackdrop = false,
  motion,
  class: className,
  style,
  ...rest
} = Astro.props;
const drawerStyle =
  typeof style === "string"
    ? `${style ? `${style};` : ""}--clay-drawer-width:${width}px`
    : { ...style, "--clay-drawer-width": `${width}px` };
---

{variant === "temporary" ? (
  <dialog
    {...rest}
    class:list={["clay clay-drawer", className]}
    data-variant={variant}
    data-anchor={anchor}
    data-hide-backdrop={hideBackdrop ? "" : undefined}
    style={drawerStyle}
    data-clay-dialog
    data-clay-open={open ? "" : undefined}
    data-motion={motion}
  >
    <div class="clay-drawer__panel">
      <slot />
      {Astro.slots.has("actions") && (
        <div class="clay-drawer__actions">
          <slot name="actions" />
        </div>
      )}
    </div>
  </dialog>
) : (
  <aside
    {...rest}
    class:list={["clay clay-drawer", className]}
    data-variant={variant}
    data-anchor={anchor}
    style={drawerStyle}
    data-motion={motion}
    hidden={variant === "persistent" && !open ? true : rest.hidden}
  >
    <div class="clay-drawer__panel">
      <slot />
      {Astro.slots.has("actions") && (
        <div class="clay-drawer__actions">
          <slot name="actions" />
        </div>
      )}
    </div>
  </aside>
)}

<script>
  import { upgradeDialogs } from "@claymo/core/behavior/dialog";
  import { onEveryPage } from "./lifecycle.ts";
  onEveryPage(upgradeDialogs);
</script>
