---
import type { HTMLAttributes } from "astro/types";
import { accordionRecipe, type AccordionOptions } from "@claymo/core/surfaces";

type Props = Omit<HTMLAttributes<"details">, "open"> & AccordionOptions;

const { expanded, defaultExpanded, disabled, class: className, ...rest } = Astro.props;
const recipe = accordionRecipe({ expanded, defaultExpanded, disabled });
---

<details
  class:list={["clay-accordion", className]}
  open={recipe.open}
  data-clay-accordion
  {...rest}
>
  <summary class="clay clay-accordion__summary" data-clay-interactive {...recipe.summaryAttrs}>
    <span class="clay-accordion__title">
      <slot name="summary" />
    </span>
    <svg
      class="clay-accordion__chevron"
      aria-hidden="true"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </summary>
  <div class="clay clay-accordion__content">
    <slot />
  </div>
</details>

<script>
  import { upgradeAccordions } from "@claymo/core/behavior/surfaces";
  import { onEveryPage } from "./lifecycle.ts";
  onEveryPage(upgradeAccordions);
</script>
