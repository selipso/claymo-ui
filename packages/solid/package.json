{
  "name": "@claymo/solid",
  "version": "0.2.0",
  "description": "Solid 2 components for the Claymo design system.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/client.js",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@claymo/core": "0.2.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.3",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.3",
    "solid-js": "^2.0.3",
    "vite": "^8.3.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selipso/claymo-ui.git",
    "directory": "packages/solid"
  },
  "homepage": "https://github.com/selipso/claymo-ui#readme",
  "bugs": {
    "url": "https://github.com/selipso/claymo-ui/issues"
  }
}
