{
  "name": "claymo-ui",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24",
    "npm": ">=9.6.5"
  },
  "workspaces": [
    "packages/core",
    "packages/svelte",
    "packages/astro",
    "packages/mcp",
    "apps/playground"
  ],
  "scripts": {
    "prepare": "npm run build -w @claymo/core -w @claymo/svelte",
    "start": "npm run dev",
    "dev": "npm run dev -w @claymo/playground",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @claymo/playground",
    "test:packed": "node scripts/test-packed.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.0",
    "typescript": "^6.0.3"
  }
}
